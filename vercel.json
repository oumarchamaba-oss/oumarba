{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ],
  "redirects": [
    { "source": "/formation", "destination": "/formation-hcd", "permanent": true },
    { "source": "/guides", "destination": "/guides-hcd", "permanent": true }
  ]
}
